{
    "name": "datalogix/laravel-guardian",
    "description": "Extensible Laravel authentication package providing actions for login, logout, sign-up, password reset, email verification and related security features.",
    "keywords": [
        "laravel",
        "authentication",
        "login",
        "logout",
        "signup",
        "password-reset",
        "email-verification",
        "security",
        "rate-limiting",
        "guard"
    ],
    "homepage": "https://github.com/datalogix/laravel-guardian",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ricardo Gobbo de Souza",
            "email": "ricardogobbosouza@yahoo.com.br"
        }
    ],
    "require": {
        "php": "^8.2",
        "bacon/bacon-qr-code": "^3.0",
        "laravel/framework": "^12.0|^13.0",
        "pragmarx/google2fa": "^9.0"
    },
    "require-dev": {
        "graham-campbell/testbench": "^6.3",
        "inertiajs/inertia-laravel": "^2.0|^3.0",
        "laravel/pint": "^1.30",
        "laravel/socialite": "^5.11",
        "livewire/livewire": "^4.4",
        "phpunit/phpunit": "^11.5"
    },
    "conflict": {
        "laravel/framework": "12.69.0"
    },
    "suggest": {
        "datalogix/tallkit": "Provides the <tk:> Blade components the bundled Livewire views are built with (^0.1).",
        "inertiajs/inertia-laravel": "Required to use the Inertia front-end (^2.0|^3.0).",
        "laravel/socialite": "Required to use the OAuth / social login feature (^5.11).",
        "livewire/livewire": "Required to use the Livewire front-end (^4.4)."
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Datalogix\\Guardian\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Datalogix\\Guardian\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Datalogix\\Guardian\\GuardianServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
